# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Dirección del frontend; se usa en los enlaces de los correos (restablecer contraseña, mis cursos)
APP_URL=http://localhost:5173

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://sigecap:CAMBIAR_CONTRASENA@localhost:5432/sigecap?schema=public"

# JWT (usa una cadena aleatoria de al menos 32 caracteres: openssl rand -hex 32)
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Correo (SMTP institucional o de pruebas)
SMTP_HOST=smtp.ejemplo.gob.mx
SMTP_PORT=587
SMTP_USER=capacitacion@ejemplo.gob.mx
SMTP_PASS=CAMBIAR
MAIL_FROM="Capacitación CNBBBJ <capacitacion@ejemplo.gob.mx>"

# Archivos
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Administrador inicial (solo lo usa prisma/seed.ts)
ADMIN_CURP=XEXX010101HOCXXX01
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema
ADMIN_CORREO=admin@ejemplo.gob.mx
ADMIN_CORREO_RESPALDO=respaldo@ejemplo.com
ADMIN_TELEFONO=9510000000
ADMIN_PASSWORD=CambiarEsta123
