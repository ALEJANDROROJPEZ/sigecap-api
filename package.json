    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/swagger-ui-express": "4.1.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
