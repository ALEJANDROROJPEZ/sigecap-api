// Modelo de datos de SIGECAP (corresponde al diagrama entidad-relación del reporte)

generator client {
  provider = "prisma-client"
  output   = "../src/config/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum TipoSede {
  ORE
  SARE
}

enum TipoContratacion {
  ESTRUCTURA
  HONORARIOS
}

enum TemaInterfaz {
  CLARO
  OSCURO
}

enum EstadoCursoEmpleado {
  PENDIENTE
  EN_REVISION
  COMPLETADO
  RECHAZADO
}

enum OrigenRegistro {
  ASIGNACION
  HISTORICO
}

enum EstadoEvidencia {
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADO
  ERROR
}

model Rol {
  id          Int       @id @default(autoincrement()) @map("id_rol")
  nombre      String    @unique @db.VarChar(30)
  descripcion String?   @db.VarChar(150)
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  id                Int                 @id @default(autoincrement()) @map("id_usuario")
  idRol             Int                 @map("id_rol")
  idEmpleado        Int                 @unique @map("id_empleado")
  contrasenaHash    String              @map("contrasena_hash") @db.VarChar(100)
  temaInterfaz      TemaInterfaz        @default(CLARO) @map("tema_interfaz")
  activo            Boolean             @default(true)
  ultimoAcceso      DateTime?           @map("ultimo_acceso")
  rol               Rol                 @relation(fields: [idRol], references: [id])
  empleado          Empleado            @relation(fields: [idEmpleado], references: [id])
  tokens            TokenRecuperacion[]
  asignaciones      Asignacion[]
  evidenciasRevisadas Evidencia[]       @relation("RevisadoPor")
  notificaciones    Notificacion[]
  bitacora          Bitacora[]

  @@map("usuario")
}

model TokenRecuperacion {
  id        Int      @id @default(autoincrement()) @map("id_token")
  idUsuario Int      @map("id_usuario")
  tokenHash String   @map("token_hash") @db.VarChar(100)
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  usuario   Usuario  @relation(fields: [idUsuario], references: [id])

  @@map("token_recuperacion")
}

model Sede {
  id           Int          @id @default(autoincrement()) @map("id_sede")
  clave        String       @unique @db.VarChar(20)
  nombre       String       @db.VarChar(120)
  tipo         TipoSede
  empleados    Empleado[]
  asignaciones Asignacion[]

  @@map("sede")
}

model Area {
  id        Int        @id @default(autoincrement()) @map("id_area")
  nombre    String     @unique @db.VarChar(120)
  empleados Empleado[]

  @@map("area")
}

model Empleado {
  id                  Int              @id @default(autoincrement()) @map("id_empleado")
  cupo                String           @unique @db.Char(6)
  curp                String           @unique @db.Char(18)
  numTrabajadorRusp   String?          @map("num_trabajador_rusp") @db.VarChar(20)
  tipoContratacion    TipoContratacion @map("tipo_contratacion")
  nombre              String           @db.VarChar(80)
  apellidoPaterno     String           @map("apellido_paterno") @db.VarChar(60)
  apellidoMaterno     String?          @map("apellido_materno") @db.VarChar(60)
  correoInstitucional String?          @unique @map("correo_institucional") @db.VarChar(120)
  correoRespaldo      String?          @map("correo_respaldo") @db.VarChar(120)
  telefono            String?          @db.VarChar(10)
  puesto              String           @db.VarChar(120)
  idArea              Int              @map("id_area")
  idSede              Int              @map("id_sede")
  activo              Boolean          @default(true)
  area                Area             @relation(fields: [idArea], references: [id])
  sede                Sede             @relation(fields: [idSede], references: [id])
  usuario             Usuario?
  cursos              CursoEmpleado[]

  @@map("empleado")
}

model Dependencia {
  id     Int     @id @default(autoincrement()) @map("id_dependencia")
  siglas String  @unique @db.VarChar(30)
  nombre String  @db.VarChar(200)
  cursos Curso[]

  @@map("dependencia")
}

model TemaEtica {
  id          Int     @id @default(autoincrement()) @map("id_tema_etica")
  codigo      String  @unique @db.VarChar(20)
  descripcion String  @db.VarChar(250)
  cursos      Curso[]

  @@map("tema_etica")
}

model Curso {
  id                     Int             @id @default(autoincrement()) @map("id_curso")
  idDependencia          Int             @map("id_dependencia")
  idTemaEtica            Int?            @map("id_tema_etica")
  nombre                 String          @db.VarChar(250)
  nombreCorto            String?         @map("nombre_corto") @db.VarChar(80)
  ordenReporte           Int?            @map("orden_reporte")
  aplicaEstructura       Boolean         @default(true) @map("aplica_estructura")
  aplicaHonorarios       Boolean         @default(true) @map("aplica_honorarios")
  descripcion            String?
  trimestre              Int             @db.SmallInt
  anio                   Int             @db.SmallInt
  fechaInicio            DateTime?       @map("fecha_inicio") @db.Date
  fechaLimiteRegistro    DateTime?       @map("fecha_limite_registro") @db.Date
  fechaEntregaConstancia DateTime?       @map("fecha_entrega_constancia") @db.Date
  urlPlataforma          String?         @map("url_plataforma") @db.VarChar(300)
  activo                 Boolean         @default(true)
  dependencia            Dependencia     @relation(fields: [idDependencia], references: [id])
  temaEtica              TemaEtica?      @relation(fields: [idTemaEtica], references: [id])
  asignaciones           Asignacion[]
  cursosEmpleado         CursoEmpleado[]

  @@map("curso")
}

model Asignacion {
  id              Int             @id @default(autoincrement()) @map("id_asignacion")
  idCurso         Int             @map("id_curso")
  idSede          Int?            @map("id_sede")
  esGeneral       Boolean         @default(false) @map("es_general")
  asignadoPor     Int             @map("asignado_por")
  fechaAsignacion DateTime        @default(now()) @map("fecha_asignacion")
  activo          Boolean         @default(true)
  curso           Curso           @relation(fields: [idCurso], references: [id])
  sede            Sede?           @relation(fields: [idSede], references: [id])
  usuario         Usuario         @relation(fields: [asignadoPor], references: [id])
  cursosEmpleado  CursoEmpleado[]
  envios          EnvioCorreo[]

  @@map("asignacion")
}

model CursoEmpleado {
  id           Int                 @id @default(autoincrement()) @map("id_curso_empleado")
  idCurso      Int                 @map("id_curso")
  idAsignacion Int?                @map("id_asignacion")
  idEmpleado   Int                 @map("id_empleado")
  estado       EstadoCursoEmpleado @default(PENDIENTE)
  origen       OrigenRegistro      @default(ASIGNACION)
  curso        Curso               @relation(fields: [idCurso], references: [id])
  asignacion   Asignacion?         @relation(fields: [idAsignacion], references: [id])
  empleado     Empleado            @relation(fields: [idEmpleado], references: [id])
  evidencias   Evidencia[]

  @@unique([idCurso, idEmpleado])
  @@map("curso_empleado")
}

model Evidencia {
  id                 Int             @id @default(autoincrement()) @map("id_evidencia")
  idCursoEmpleado    Int             @map("id_curso_empleado")
  nombreArchivo      String          @map("nombre_archivo") @db.VarChar(255)
  rutaArchivo        String          @unique @map("ruta_archivo") @db.VarChar(255)
  tamanoBytes        Int             @map("tamano_bytes")
  fechaInicioCurso   DateTime        @map("fecha_inicio_curso") @db.Date
  fechaConclusion    DateTime        @map("fecha_conclusion") @db.Date
  estado             EstadoEvidencia @default(EN_REVISION)
  comentarioRevision String?         @map("comentario_revision")
  revisadoPor        Int?            @map("revisado_por")
  fechaSubida        DateTime        @default(now()) @map("fecha_subida")
  fechaRevision      DateTime?       @map("fecha_revision")
  cursoEmpleado      CursoEmpleado   @relation(fields: [idCursoEmpleado], references: [id])
  revisor            Usuario?        @relation("RevisadoPor", fields: [revisadoPor], references: [id])

  @@map("evidencia")
}

model Notificacion {
  id        Int      @id @default(autoincrement()) @map("id_notificacion")
  idUsuario Int      @map("id_usuario")
  tipo      String   @db.VarChar(40)
  titulo    String   @db.VarChar(150)
  mensaje   String
  leida     Boolean  @default(false)
  creadaEn  DateTime @default(now()) @map("creada_en")
  usuario   Usuario  @relation(fields: [idUsuario], references: [id])

  @@map("notificacion")
}

model PlantillaCorreo {
  id         Int           @id @default(autoincrement()) @map("id_plantilla")
  nombre     String        @unique @db.VarChar(60)
  asunto     String        @db.VarChar(200)
  cuerpoHtml String        @map("cuerpo_html")
  envios     EnvioCorreo[]

  @@map("plantilla_correo")
}

model EnvioCorreo {
  id                 Int             @id @default(autoincrement()) @map("id_envio")
  idPlantilla        Int             @map("id_plantilla")
  idAsignacion       Int?            @map("id_asignacion")
  totalDestinatarios Int             @map("total_destinatarios")
  estado             EstadoEnvio     @default(PENDIENTE)
  fechaEnvio         DateTime        @default(now()) @map("fecha_envio")
  plantilla          PlantillaCorreo @relation(fields: [idPlantilla], references: [id])
  asignacion         Asignacion?     @relation(fields: [idAsignacion], references: [id])

  @@map("envio_correo")
}

model Bitacora {
  id               Int      @id @default(autoincrement()) @map("id_bitacora")
  idUsuario        Int?     @map("id_usuario")
  accion           String   @db.VarChar(40)
  entidad          String   @db.VarChar(40)
  idEntidad        Int?     @map("id_entidad")
  datosAnteriores  Json?    @map("datos_anteriores")
  datosNuevos      Json?    @map("datos_nuevos")
  ipOrigen         String?  @map("ip_origen") @db.VarChar(45)
  fecha            DateTime @default(now())
  usuario          Usuario? @relation(fields: [idUsuario], references: [id])

  @@map("bitacora")
}
